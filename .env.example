# Copy this file to ".env" and fill in real values. NEVER commit the real .env
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname
PORT=3000

# Long random string used to sign session cookies (required in production)
SESSION_SECRET=replace-with-a-long-random-string

# Admin account auto-created on first boot only if no users exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
