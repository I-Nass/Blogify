<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' && title ? title : 'Blogify' %>
    </title>
    <meta name="description"
        content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Fresh perspectives on the modern digital world through Blogify.' %>">
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✍️</text></svg>">
    <link rel="stylesheet" href="/css/main.css">
</head>
<body<% if (typeof bodyClass !=='undefined' && bodyClass) { %> class="<%= bodyClass %>"<% } %>>