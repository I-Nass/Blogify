<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="shell pageBody">
    <div class="pageHead">
        <h1>Browse tags</h1>
    </div>

    <% if (tags.length) { %>
        <ul class="tagCloud">
            <% tags.forEach(t => { %>
                <li>
                    <a class="tagChip lg" href="/tag/<%= encodeURIComponent(t._id) %>">
                        #<%= t._id %><span class="count"><%= t.count %></span>
                    </a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <div class="emptyState"><p><%= emptyMessage %></p><a class="btn btnPrimary" href="/">Back home</a></div>
    <% } %>
</main>

<%- include('partials/footer') %>
